# 钢材缺陷检测系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际配置

# ==================== 应用配置 ====================
DEBUG=True
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ==================== 安全配置 ====================
# 请使用随机生成的密钥，至少32字符
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS配置 ====================
# 允许的前端地址，用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==================== AI模型配置 ====================
YOLO_MODEL_PATH=./models/best.pt
UNET_MODEL_PATH=./models/unet.pth
USE_CUDA=True
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMG_SIZE=640

# ==================== 讯飞星火API配置 ====================
# 文本对话API
SPARK_API_KEY=user_id:api_key
SPARK_MODEL=4.0Ultra

# 图片理解API（AI分析功能必需）
SPARK_IMAGE_APP_ID=your_app_id
SPARK_IMAGE_API_KEY=your_api_key
SPARK_IMAGE_API_SECRET=your_api_secret

# ==================== 文件存储配置 ====================
UPLOAD_DIR=./uploads
CAPTURE_DIR=./captures
MAX_UPLOAD_SIZE=10485760  # 10MB

# ==================== 数据库配置 ====================
# SQLite配置（默认，零配置）
DATABASE_URL=sqlite:///./data/steel_defect.db

# MySQL配置（可选，取消注释即可切换）
# DATABASE_URL=mysql://root:123456@localhost:3306/steel_defect

# ==================== 管理员配置 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@steeldefect.com

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
