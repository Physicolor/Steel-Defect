# ============================================
# 钢材缺陷检测系统 - 环境变量配置示例
# ============================================
# 说明：复制此文件为 .env，并填入你的实际配置值
# 注意：.env 文件包含敏感信息，请勿提交到版本控制系统
# ============================================

# --------------------------------------------
# Flask 应用配置
# --------------------------------------------
# 是否开启调试模式 (true/false)
FLASK_DEBUG=false

# Flask 服务器监听地址 (0.0.0.0 表示允许外部访问)
FLASK_HOST=0.0.0.0

# Flask 服务器监听端口
FLASK_PORT=5000

# --------------------------------------------
# 计算设备配置
# --------------------------------------------
# 是否使用 CUDA GPU 加速 (true/false)
# 设置为 false 将强制使用 CPU（默认自动检测 CUDA）
USE_CUDA=true

# --------------------------------------------
# 讯飞星火图片理解 API 配置
# --------------------------------------------
# 在讯飞开放平台创建应用后获取以下凭证
# 平台地址: https://console.xfyun.cn/
SPARK_IMAGE_APP_ID=your_app_id_here
SPARK_IMAGE_API_KEY=your_api_key_here
SPARK_IMAGE_API_SECRET=your_api_secret_here

# --------------------------------------------
# 讯飞星火 Lite 文本对话 API 配置
# --------------------------------------------
# Spark Lite 模型用于智能分析和建议
# 在讯飞开放平台创建应用后获取以下凭证
SPARK_LITE_APP_ID=your_lite_app_id_here
SPARK_LITE_API_KEY=your_lite_api_key_here
SPARK_LITE_API_SECRET=your_lite_api_secret_here
